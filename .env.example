# 转发前的地址
UPSTREAM_URL=https://yibuapi.com/v1  # 后缀写到v1
UPSTREAM_API_KEY="填入AK"  # 上游服务密钥
MODEL_ID=

# 客户端验证（可选）
# 客户端调用本代理时的验证密钥，不设置则不进行验证（也支持数据库管理 key）
ENABLE_KEY_ACCESS=true
API_KEY=

# 转发后的地址
PROXY_HOST=127.0.0.1
PROXY_PORT=4000

# 日志路径（绝对路径，权威来源；设置后不再依赖 LOG_TASK_TAG/PROXY_PORT/UPSTREAM_API_KEY 推导）
# LOG_DIR: 服务实例目录（export/session/backup 等 DB 落在此处）
LOG_DIR=/root/llm-proxy-main/logs/port8084/env-99oR
# DATA_DIR: 日志数据 base 目录（env 根目录）
DATA_DIR=/root/llm-proxy-main/logs_all/env-99oR

# 其他参数
SSL_VERIFY=false
BAN_EXPLORE=false
BAN_STREAM=false

# 代理相关
TRUST_ENV=true  # 为true时使用下面全局环境变量，密码特殊字符记得转码
HTTP_PROXY=http://账号:密码@proxyhk.xx.com:8080
HTTPS_PROXY=http://账号:密码@proxyhk.xx.com:8080
NO_PROXY=localhost,127.0.0.1,*.local,*.lan,10.70.85.106

# 监控界面登录
MONITOR_USERNAME=root
MONITOR_PASSWORD=hw123456
MONITOR_SESSION_SECRET=5804b8aa-33f6-11f1-a791-00155d57fecb
MONITOR_COOKIE_SECURE=false
MONITOR_SESSION_MAX_AGE=43200

# ── new-api 实时索引服务（src/watch/worker.py）──────────────────────────────
# 把 new-api 叶子 index.jsonl 的增量同步进 index.db，让新记录秒级可见。
# 启动：./app watch start --env .env（./app start 也会一并拉起）
# 看板：http://<host>:<port>/watch
# 文档：doc/watcher.md
#
# 以下全部可选，不填就用 utils/watch_config.py 里的默认值。
# 注释掉即为使用默认值；取消注释即可覆盖。非法值只告警并回退默认。

# 叶子间并发上限：同时处理多少个不同的叶子（看板「并发 N/8」即此值）。
# WATCH_CONCURRENCY=8

# 发现线程轮询周期（秒）。每源一个线程，每轮只 stat index.jsonl。
# WATCH_POLL_SEC=5

# 单叶 enrich 并发子进程数（解析合并文件补 meta，昂贵阶段）。
# WATCH_ENRICH_WORKERS=4

# 全局 enrich 子进程上限（跨所有并发任务共享，非阻塞分配）。
# 防止 8 任务 × 4 worker = 32 个 spawn 进程压垮 NFS。
# WATCH_ENRICH_BUDGET=12

# pending 行数低于此值走进程内单进程快路径（不起 spawn 池，省 ~100ms 启动开销）。
# WATCH_ENRICH_INLINE_THRESHOLD=1000

# 快扫范围：最近 N 天 × 最近 M 小时。新数据只会落在最新的 hour 目录。
# WATCH_FAST_SCAN_DAYS=2
# WATCH_FAST_SCAN_HOURS=3

# 全量扫描兜底周期（秒）。快扫之外的叶子靠它发现（防漏历史增量）。
# WATCH_FULL_SCAN_EVERY=60

# 队列优先级（越大越先）。当前小时的数据决定实时可见性，必须最先同步。
# WATCH_PRIO_NOW=100
# WATCH_PRIO_RECENT=50
# WATCH_PRIO_OLD=0

# 「最近」的判定阈值（小时），用于上面 PRIO_RECENT。
# WATCH_RECENT_HOURS=3

# 单叶同步：ingest 分批行数（避免长事务长期占写锁）。
# WATCH_SYNC_BATCH=500

# enrich 判定「卡住」的超时（秒），多因 NFS 读死等。超时后跳过该叶子待补跑。
# WATCH_ENRICH_STALL_TIMEOUT=60

# ── 回填 worker 的小时级 auto_sync ──────────────────────────────────────────
# 0 = 关闭（默认）。实时索引已覆盖增量，周期全量扫盘只会和 watch worker 抢锁。
# 需要恢复旧的每小时自动回填行为时设为 3600。
# BACKFILL_AUTO_SYNC_INTERVAL=0